# ==============================================================================
# NileLink Environment Configuration (Production & Hostinger Node.js)
# ==============================================================================

# Server
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"

# Security (REQUIRED in production: generate with `openssl rand -hex 32`)
SESSION_SECRET=
CRON_SECRET=

# MySQL Database (Hostinger hPanel -> Databases)
# IMPORTANT for Hostinger Node.js: always use 127.0.0.1 instead of localhost
# to avoid IPv6 ::1 access denied errors.
DATABASE_URL="mysql://u123456789_user:password@127.0.0.1:3306/u123456789_nilelink"

# Persistent File Storage (MUST be outside the deployed build folder)
# Example on Hostinger: /home/u123456789/nilelink-uploads
STORAGE_DIR=

# Optional S3-Compatible Object Storage (leave empty for local persistent disk)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP Email (Hostinger Email or external SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NileLink <no-reply@yourdomain.com>"

# SMS / OTP Adapter (Needs my input: configure provider credentials when chosen)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Card Payment Gateway Adapter (Needs my input: Bank Audi / Credit Libanais / Areeba)
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_API_KEY=
