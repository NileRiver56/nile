    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
